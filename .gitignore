nbproject/private/
nbdist/
nbbuild/
nb-configuration.xml

# --- IntelliJ IDEA ---
.idea/
*.iml
*.ipr
*.iws

# --- Visual Studio Code ---
.vscode/

# --- Sistema operativo ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Varios ---
*.tmp
*.bak
